# Copy this file to .env and fill in real values. Never commit .env.
#
# Locally, Supabase's "Direct connection" string works fine. Deploying to a
# cloud host (Railway, confirmed) may need the "Session pooler" string
# instead (aws-0-<region>.pooler.supabase.com) — Direct connection can
# resolve to an IPv6 address some hosts can't route, and even IPv4 can hit a
# firewalled egress. See SCOPE_TRACKER.md "Known fragility" for the full story.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Random long string — used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000

# GAS Web App URL — used by the one-time/sync migration scripts only
# (scripts/migrate-*.js, scripts/sync-*.js), not by the running server.
GAS_URL=
# Matches GAS's SUPERVISOR_PIN Script Property — used by the same scripts
# to log in as Supervisor and pull company-wide data.
SUPERVISOR_PIN=

# Supabase project URL + service-role key — only needed for the
# /content/upload route (Supabase Storage). Service-role key is a secret;
# never send it to the browser, only used server-side here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
